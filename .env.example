# Copy to .env.local for local overrides. None of these are needed for the demo.

# demo (default): seed data, simulated adapters, one-time codes shown on screen.
# production: no seed data, no simulation, no on-screen codes; TRACE_SECRET is mandatory.
TRACE_MODE=demo

# Master secret, at least 32 characters. Encryption, HMAC and session keys are derived from it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# TRACE_SECRET=

# PostgreSQL connection string. Leave unset to use the embedded database (PGlite).
# DATABASE_URL=postgres://user:password@host:5432/jtrace

# TRACE_DB=memory   # force an in-memory embedded database
# TRACE_SEED=off    # skip demo data in demo mode
