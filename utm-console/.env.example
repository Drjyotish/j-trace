# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project settings -> API). Leave both empty to run in local demo mode
# (data stays in this browser only, no login).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bitly (Settings -> Developer settings -> API -> Generate token). Server-side only.
BITLY_TOKEN=
# Optional: your Bitly group guid; leave empty to use the account default.
BITLY_GROUP_GUID=
# Optional: a branded short domain set up in Bitly (default bit.ly).
BITLY_DOMAIN=
